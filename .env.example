# STALKER Environment Variables
# Copy this file to .env and fill in your details.
# The system works WITHOUT these — email is optional.

# ─────────────────────────────────────────────
# MongoDB (Optional — will use local JSON if not set)
# Provide your connection string when ready
# ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/

# ─────────────────────────────────────────────
# Gmail Email Reports (Optional)
# Use a Gmail App Password, NOT your real password.
# Get one at: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────
EMAIL_SENDER=your.email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_RECEIVER=recipient@gmail.com
